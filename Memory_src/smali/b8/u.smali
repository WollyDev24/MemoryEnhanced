    const-string v1, "\n        UPDATE memory\n        SET title = NULL,\n            is_title_user_edited = 0,\n            body = NULL,\n            useful_information = NULL,\n            information_assets = NULL,\n            analysis_status = ?,\n            analysis_error_code = ?,\n            action_count = 0,\n            representative_title = COALESCE(\n                NULLIF(TRIM(representative_voice_transcript), \'\'),\n                NULLIF(TRIM(source_text), \'\'),\n                NULLIF(TRIM(user_note), \'\')\n            ),\n            has_representative_title = CASE\n                WHEN COALESCE(\n                    NULLIF(TRIM(representative_voice_transcript), \'\'),\n                    NULLIF(TRIM(source_text), \'\'),\n                    NULLIF(TRIM(user_note), \'\')\n                ) IS NULL THEN 0\n                ELSE 1\n            END,\n            representative_place_poi = NULL,\n            representative_place_address = NULL,\n            representative_tag = NULL,\n            category = NULL,\n            suggested_category = NULL,\n            secondary_category = NULL,\n            secondary_suggested_category = NULL,\n            sub_collection_seed = NULL\n        WHERE deleted = 0\n        "

