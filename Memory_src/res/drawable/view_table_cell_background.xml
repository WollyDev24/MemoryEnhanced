<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/capsule_view_table_cell_selected" />
            <stroke android:width="1.0px" android:color="@color/capsule_view_table_text_color" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/capsule_view_table_cell_active" />
            <stroke android:width="1.0px" android:color="@color/capsule_view_table_text_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.0px" android:color="@color/capsule_view_table_text_color" />
        </shape>
    </item>
</selector>
