<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.graphics.drawable.SeslRecoilDrawable app:seslRecoilColor="@color/recoil_color"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item>
        <selector>
            <item android:state_selected="true">
                <androidx.appcompat.util.SeslShapeDrawable android:shape="rectangle">
                    <solid android:color="@color/basic_token_sys_on_surface_container_high" />
                    <corners android:radius="@dimen/home_source_chip_radius" />
                </androidx.appcompat.util.SeslShapeDrawable>
            </item>
            <item>
                <androidx.appcompat.util.SeslShapeDrawable android:shape="rectangle">
                    <solid android:color="@color/basic_token_sys_surface" />
                    <corners android:radius="@dimen/home_source_chip_radius" />
                </androidx.appcompat.util.SeslShapeDrawable>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <androidx.appcompat.util.SeslShapeDrawable android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/home_source_chip_radius" />
        </androidx.appcompat.util.SeslShapeDrawable>
    </item>
</androidx.appcompat.graphics.drawable.SeslRecoilDrawable>
